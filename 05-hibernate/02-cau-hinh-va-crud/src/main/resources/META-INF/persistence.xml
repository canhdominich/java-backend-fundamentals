<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.2">
    <persistence-unit name="lab">
        <class>dev.canhdominich.hibernate.crud.Student</class>
        <properties>
            <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
            <property name="hibernate.session_factory.statement_inspector" value="dev.canhdominich.hibernate.crud.SqlRecorder"/>
        </properties>
    </persistence-unit>
</persistence>
